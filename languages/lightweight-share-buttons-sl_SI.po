#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Lahki gumbi za skupno rabo"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Lahek, zasebnost prijazen blok za skupno rabo na družbenih omrežjih s podporo za nativno skupno rabo in kopiranje."

#. Author of the plugin
#: lightweight-share-buttons.php:8
