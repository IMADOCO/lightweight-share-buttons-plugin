#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Გამოიყენება Native Share ‑ ის, WhatsApp ‑ ის, ელფოსტის, Telegram ‑ ის, X ‑ ის, Bluesky ‑ ს, Thread ‑ ებისა და Reddit ‑ ის მეშვეობით. Facebook-მა და LinkedIn-მა სათაური წაიკითხეს გვერდიდან Open Graph metadata."

#: src/index.js:114
msgid "Message text (optional)"
msgstr "Შეტყობინების ტექსტი (არასავალდებულო)"

#: src/index.js:114
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, and Threads. Facebook and LinkedIn do not accept a custom message; Reddit uses only the title and URL."
msgstr "Გამოიყენება Native Share ‑ ის, WhatsApp ‑ ის, ელფოსტის, Telegram ‑ ის, X ‑ ის, Bluesky ‑ ისა და Thread ‑ ების მეშვეობით. Facebook და LinkedIn არ იღებენ ინდივიდუალურ შეტყობინებას; Reddit იყენებს მხოლოდ სათაურსა და URL-ს."

