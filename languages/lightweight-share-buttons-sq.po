#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Përdoret nga Native Share, WhatsApp, email, Telegram, X, Bluesky, Temat dhe Reddit. Facebook dhe LinkedIn lexuan titullin nga faqja Open Graph metadata."

#: src/index.js:114
msgid "Message text (optional)"
msgstr "Teksti i mesazhit (opsional)"

#: src/index.js:114
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, and Threads. Facebook and LinkedIn do not accept a custom message; Reddit uses only the title and URL."
msgstr "Përdoret nga Native Share, WhatsApp, email, Telegram, X, Bluesky dhe Temat. Facebook dhe LinkedIn nuk pranojnë një mesazh të personalizuar; Reddit përdor vetëm titullin dhe URL-në."

