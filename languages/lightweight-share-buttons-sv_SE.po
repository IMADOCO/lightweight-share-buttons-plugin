#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Lättviktsdelningsknappar"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Ett lättviktigt, integritetsvänligt socialt delningsblock med inbyggt stöd för delning och copy-link."

#. Author of the plugin
