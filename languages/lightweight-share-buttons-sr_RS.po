#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Koriste ga Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads i Reddit. Facebook i LinkedIn su pročitali naslov sa stranice Open Graph metapodaci."

