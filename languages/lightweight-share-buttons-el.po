#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Ελαφριά κουμπιά κοινοποίησης"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Ένα ελαφρύ, φιλικό προς το απόρρητο μπλοκ κοινοποίησης στα μέσα κοινωνικής δικτύωσης με εγγενή κοινοποίηση και υποστήριξη συνδέσμου αντιγραφής."

#. Author of the plugin
#: lightweight-share-buttons.php:8
msgid "IMADO"
msgstr "IMADO"

#. Author URI of the plugin
#: lightweight-share-buttons.php:9
msgid "https://imado.co"
msgstr "https://imado.co"

