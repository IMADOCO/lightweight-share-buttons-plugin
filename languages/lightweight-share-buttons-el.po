#: src/index.js:107
msgid "Enable more platforms or change the order of active buttons."
msgstr "Ενεργοποιήστε περισσότερες πλατφόρμες ή αλλάξτε τη σειρά των ενεργών κουμπιών."

#: src/index.js:109
msgid "Restore defaults"
msgstr "Επαναφορά προεπιλογών"

#: src/index.js:110
msgid "Content"
msgstr "Content"

#: src/index.js:111
msgid "Show heading"
msgstr "Εμφάνιση επικεφαλίδας"

#: src/index.js:112
msgid "Heading"
msgstr "Επικεφαλίδα"

#: src/index.js:113
msgid "Custom title (optional)"
msgstr "Προσαρμοσμένος τίτλος (προαιρετικά)"

#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Χρησιμοποιείται από τα Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads και Reddit. Το Facebook και το LinkedIn διαβάζουν τον τίτλο από τη σελίδα Open Graph metadata."

#: src/index.js:114
msgid "Message text (optional)"
msgstr "Κείμενο μηνύματος (προαιρετικά)"

#: src/index.js:114
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, and Threads. Facebook and LinkedIn do not accept a custom message; Reddit uses only the title and URL."
msgstr "Χρησιμοποιείται από τα Native Share, WhatsApp, email, Telegram, X, Bluesky και Threads. Το Facebook και το LinkedIn δεν αποδέχονται ένα προσαρμοσμένο μήνυμα. Το Reddit χρησιμοποιεί μόνο τον τίτλο και τη διεύθυνση URL."

#: src/index.js:115
#: src/index.js:116
msgid "Custom URL"
msgstr "Εξατομικευμένη διεύθυνση URL"

#: src/index.js:115
msgid "The custom URL will be shared."
msgstr "Η προσαρμοσμένη διεύθυνση URL θα κοινοποιηθεί."

#: src/index.js:115
msgid "The current page URL will be shared automatically."
msgstr "Η τρέχουσα διεύθυνση URL της σελίδας θα κοινοποιηθεί αυτόματα."

#: src/index.js:116
msgid "Enter a full URL or a domain, for example example.com/page."
msgstr "Εισαγάγετε μια πλήρη διεύθυνση URL ή έναν τομέα, για παράδειγμα example.com/page."

