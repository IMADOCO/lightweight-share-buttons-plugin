#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Naudoja „Native Share“, „WhatsApp“, el. paštas, „Telegram“, „X“, „Bluesky“, „Threads“ ir „Reddit“. „Facebook“ ir „LinkedIn“ perskaitė pavadinimą iš puslapio Atidaryti diagramos metaduomenis."

#: src/index.js:114
msgid "Message text (optional)"
msgstr "Žinutės tekstas (nebūtinas)"

#: src/index.js:114
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, and Threads. Facebook and LinkedIn do not accept a custom message; Reddit uses only the title and URL."
msgstr "Naudoja „Native Share“, „WhatsApp“, el. paštas, „Telegram“, „X“, „Bluesky“ ir gijos. „Facebook“ ir „LinkedIn“ nepriima pasirinktinės žinutės; „Reddit“ naudoja tik pavadinimą ir URL."

