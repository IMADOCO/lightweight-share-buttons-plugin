#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Lengvo dalijimosi mygtukai"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Lengvas, privatumui palankus dalijimosi socialiniais tinklais blokas su vietiniu dalijimusi ir kopijavimo nuorodų palaikymu."

#. Author of the plugin
#: lightweight-share-buttons.php:8
