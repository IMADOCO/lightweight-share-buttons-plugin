#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Botones de compartir ligeros"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Un bloque de intercambio social ligero y respetuoso con la privacidad con soporte nativo para compartir y copiar enlaces."

#. Author of the plugin
#: lightweight-share-buttons.php:8
msgid "IMADO"
