#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Používá se pro Nativní sdílení, WhatsApp, e-mail, Telegram, X, Bluesky, Threads a Reddit. Facebook a LinkedIn načítají název z metadat Open Graph stránky."

#: src/index.js:114
