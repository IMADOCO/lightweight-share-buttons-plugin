#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Легкі кнопки \"Поділитися\""

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Легкий, зручний для конфіденційності блок спільного доступу до соціальних мереж із підтримкою нативного спільного доступу та копіювальних посилань."

#. Author of the plugin
#: lightweight-share-buttons.php:8
msgid "IMADO"
msgstr "IMADO"

#. Author URI of the plugin
#: lightweight-share-buttons.php:9
msgid "https://imado.co"
msgstr "https://imado.co"

