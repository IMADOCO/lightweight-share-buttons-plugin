#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Utilizzato da Native Share, WhatsApp, e-mail, Telegram, X, Bluesky, Threads e Reddit. Facebook e LinkedIn leggono il titolo dalla pagina Open Graph metadata."

#: src/index.js:114
msgid "Message text (optional)"
msgstr "Testo del messaggio (facoltativo)"

#: src/index.js:114
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, and Threads. Facebook and LinkedIn do not accept a custom message; Reddit uses only the title and URL."
msgstr "Utilizzato da Native Share, WhatsApp, e-mail, Telegram, X, Bluesky e Threads. Facebook e LinkedIn non accettano un messaggio personalizzato; Reddit utilizza solo il titolo e l'URL."

