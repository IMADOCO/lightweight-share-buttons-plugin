#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Pulsanti di condivisione leggeri"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Un blocco di condivisione sociale leggero e rispettoso della privacy con condivisione nativa e supporto copy-link."

#. Author of the plugin
#: lightweight-share-buttons.php:8
