#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Bruges af Systemdeling, WhatsApp, e-mail, Telegram, X, Bluesky, Threads og Reddit. Facebook og LinkedIn læser titlen fra sidens Open Graph-metadata."

#: src/index.js:114
msgid "Message text (optional)"
