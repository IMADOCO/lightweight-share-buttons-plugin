#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Butoane de partajare ușoare"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Un bloc de partajare socială ușor, prietenos cu viața privată, cu partajare nativă și suport pentru copiere."

