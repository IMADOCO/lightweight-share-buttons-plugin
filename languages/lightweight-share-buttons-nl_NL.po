#: src/index.js:113
msgid "Used by Native Share, WhatsApp, email, Telegram, X, Bluesky, Threads, and Reddit. Facebook and LinkedIn read the title from the page Open Graph metadata."
msgstr "Gebruikt door Native Share, WhatsApp, e-mail, Telegram, X, Bluesky, Threads en Reddit. Facebook en LinkedIn lazen de titel van de pagina Open Graph metadata."

