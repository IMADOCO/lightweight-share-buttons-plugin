#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "हल्के शेयर बटन"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "देशी शेयर और कॉपी - लिंक सपोर्ट के साथ एक हल्का, निजता के अनुकूल सोशल शेयरिंग ब्लॉक।"

#. Author of the plugin
#: lightweight-share-buttons.php:8
msgid "IMADO"
msgstr "IMADO"

#. Author URI of the plugin
#: lightweight-share-buttons.php:9
msgid "https://imado.co"
msgstr "https://imado.co"

