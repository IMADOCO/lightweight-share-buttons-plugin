#. Plugin Name of the plugin
#: lightweight-share-buttons.php:3
msgid "Lightweight Share Buttons"
msgstr "Botões de partilha leves"

#. Description of the plugin
#: lightweight-share-buttons.php:4
msgid "A lightweight, privacy-friendly social sharing block with native share and copy-link support."
msgstr "Um bloco de compartilhamento social leve e amigável à privacidade com compartilhamento nativo e suporte a links de cópia."

#. Author of the plugin
