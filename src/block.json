{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "imado/share-buttons",
  "version": "1.0.0",
  "title": "Lightweight Share Buttons",
  "category": "widgets",
  "icon": "share",
  "description": "Privacy-friendly share buttons with native sharing and copy link.",
  "keywords": ["share", "social", "sharing"],
  "textdomain": "lightweight-share-buttons",
  "attributes": {
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["native", "copy", "facebook", "whatsapp", "linkedin", "email", "telegram", "x", "bluesky", "threads", "reddit"]
      },
      "default": ["native", "copy", "facebook", "whatsapp", "linkedin"]
    },
    "displayMode": { "type": "string", "default": "icon-label" },
    "layout": { "type": "string", "default": "horizontal" },
    "alignment": { "type": "string", "default": "left" },
    "size": { "type": "string", "default": "medium" },
    "shape": { "type": "string", "default": "rounded" },
    "useBrandColors": { "type": "boolean", "default": true },
    "serviceColors": { "type": "object", "default": {} },
    "wrap": { "type": "boolean", "default": true },
    "gap": { "type": "number", "default": 8 },
    "showHeading": { "type": "boolean", "default": false },
    "heading": { "type": "string", "default": "Share" },
    "customTitle": { "type": "string", "default": "" },
    "customText": { "type": "string", "default": "" },
    "urlMode": { "type": "string", "default": "automatic" },
    "customUrl": { "type": "string", "default": "" },
    "utmEnabled": { "type": "boolean", "default": false },
    "utmSource": { "type": "string", "default": "" },
    "utmMedium": { "type": "string", "default": "social" },
    "utmCampaign": { "type": "string", "default": "" }
  },
  "usesContext": ["postId", "postType"],
  "supports": {
    "html": false,
    "anchor": true,
    "color": { "background": true, "text": true },
    "spacing": { "margin": true, "padding": true }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
